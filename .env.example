# ── LLM ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
# ^ Supabase Transaction Pooler (PgBouncer, port 6543) — NOT the direct connection (port 5432)
# SQLAlchemy engine is configured with prepare_threshold=None to disable prepared statements
# (required for PgBouncer transaction mode — see db/connection.py)

# ── LangSmith Observability ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=your-langsmith-project-name

# ── Agent Config ────────────────────────────────────────────────────────────────
# Maximum number of generator→reviewer revision cycles before force-approving
MAX_ITERATIONS=3
